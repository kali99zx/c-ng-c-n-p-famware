    <!-- esptool-js CDN -->
    <script src="https://unpkg.com/esptool-js@0.4.3/bundle.js"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        hack: {
                            bg: '#02040a',
                            card: '#080d1a',
                            panel: '#0e172a',
                            border: '#162b4d',
                            green: '#00ff66',
                            greenGlow: '#00ff88',
                            cyan: '#00f0ff',
                            red: '#ff0033',
                            redGlow: '#ff0055',
                            yellow: '#ffe600',
                            purple: '#b000ff'
                        }
                    },
                    fontFamily: {
                        orbitron: ['Orbitron', 'sans-serif'],
                        mono: ['Share Tech Mono', 'Fira Code', 'monospace']
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #02040a;
            color: #00ff66;
            overflow-x: hidden;
        }

        #matrixCanvas {
            position: fixed;
            top: 0; left: 0;
            width: 100vw; height: 100vh;
            z-index: 0;
            opacity: 0.22;
            pointer-events: none;
        }

        .crt-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.4) 50%);
            background-size: 100% 4px;
            z-index: 1;
            pointer-events: none;
            opacity: 0.6;
        }

        .cyber-box {
            position: relative;
            background: rgba(8, 13, 26, 0.92);
            backdrop-filter: blur(14px);
            border: 1px solid #162b4d;
            box-shadow: 0 0 20px rgba(0, 255, 102, 0.08);
        }

        .cyber-box-red {
            border: 1px solid #ff0033;
            box-shadow: 0 0 20px rgba(255, 0, 51, 0.15);
        }

        .cyber-box::before {
            content: '';
            position: absolute;
            top: -1px; left: -1px;
            width: 8px; height: 8px;
            border-top: 2px solid #00ff66;
            border-left: 2px solid #00ff66;
        }

        .cyber-box::after {
            content: '';
            position: absolute;
            bottom: -1px; right: -1px;
            width: 8px; height: 8px;
            border-bottom: 2px solid #00f0ff;
            border-right: 2px solid #00f0ff;
        }

        .cyber-btn {
            position: relative;
            transition: all 0.2s ease;
            clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
        }

        .cyber-btn:hover:not(:disabled) {
            transform: translateY(-2px);
            filter: drop-shadow(0 0 12px rgba(0, 255, 102, 0.6));
        }

        .fsociety-glow {
            box-shadow: 0 0 25px rgba(255, 0, 51, 0.5);
            animation: pulseFsociety 2.5s infinite alternate;
        }

        @keyframes pulseFsociety {
            0% { box-shadow: 0 0 10px rgba(255, 0, 51, 0.4); }
            100% { box-shadow: 0 0 28px rgba(255, 0, 51, 0.85); }
        }

        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #02040a; }
        ::-webkit-scrollbar-thumb { background: #162b4d; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #00ff66; }
    </style>
</head>
