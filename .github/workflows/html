        function logToTerminal(msg, type = 'info') {
            const term = document.getElementById('terminalOutput');
            const line = document.createElement('div');
            if (type === 'error') line.className = 'text-red-400 font-bold';
            else if (type === 'success') line.className = 'text-hack-green font-bold';
            else if (type === 'sent') line.className = 'text-hack-cyan italic';
            else if (type === 'flash') line.className = 'text-hack-yellow';
            else if (type === 'device') line.className = 'text-green-300 font-mono';
            else line.className = 'text-slate-400';
            line.textContent = msg;
            term.appendChild(line);
            term.scrollTop = term.scrollHeight;
        }

