            const url = document.getElementById('newFwUrl').value.trim() || 'firmwares/custom.bin';
            const img = document.getElementById('newFwImage').value.trim() || 'https://placehold.co/400x250/080d1a/ff0033?text=NEW';
            const desc = document.getElementById('newFwDesc').value.trim() || 'Được thêm bởi Admin.';

            if (!title) { alert('Nhập tên Firmware!'); return; }

            firmwareDatabase.unshift({ id: 'fw-' + Date.now(), title, chip, offset, desc, url, img });
            renderFirmwares();
            renderAdminTable();
            document.getElementById('newFwTitle').value = '';
            alert('Thêm thành công!');
        }

        function deleteFirmwareItem(id) {
            if (confirm('Xóa firmware này?')) {
                firmwareDatabase = firmwareDatabase.filter(f => f.id !== id);
                renderFirmwares();
                renderAdminTable();
            }
        }

        window.addEventListener('load', () => { renderFirmwares(); });
    </script>
