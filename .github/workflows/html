        async function flashSelectedFirmware() {
            playBeep(900, 0.1);
            if (!selectedFirmware && !customBinBuffer) { alert('Chưa chọn Firmware!'); return; }
            if (isConnected) await disconnectPort();

            try {
                logToTerminal('🚀 BẮT ĐẦU NẠP FIRMWARE (WEB SERIAL)...', 'info');
                const flashPort = await navigator.serial.requestPort();
                const baud = parseInt(document.getElementById('flashBaud').value);

                const esptoolTransport = new ESPOptions.Transport(flashPort);
                const esploader = new ESPOptions.ESPLoader({
                    transport: esptoolTransport,
                    baudrate: baud,
                    terminal: { clean: () => {}, writeLine: (d) => logToTerminal(d, 'flash'), write: (d) => logToTerminal(d, 'flash') }
                });

                await esploader.main();
                let binaryArray;
                if (customBinBuffer) {
                    binaryArray = new Uint8Array(customBinBuffer);
                } else {
                    const res = await fetch(selectedFirmware.url).catch(() => null);
                    if (res && res.ok) {
                        binaryArray = new Uint8Array(await res.arrayBuffer());
                    } else {
                        logToTerminal('⚠️ Không tìm thấy file từ server thực tế. Nạp dữ liệu giả lập kiểm thử...', 'error');
                        binaryArray = new Uint8Array(1024 * 32).fill(0x55);
                    }
                }

                const offset = parseInt(document.getElementById('flashOffset').value, 16);
                const binaryString = Array.from(binaryArray, b => String.fromCharCode(b)).join('');

                await esploader.writeFlash({
                    fileArray: [{ data: binaryString, address: offset }],
                    flashSize: 'keep',
                    eraseAll: false,
                    compress: true,
                    reportProgress: (fileIndex, written, total) => {
                        const percent = Math.floor((written / total) * 100);
                        document.getElementById('progressBar').style.width = `${percent}%`;
                        document.getElementById('progressPercent').textContent = `${percent}%`;
                    }
                });

                logToTerminal('✅ NẠP FIRMWARE THÀNH CÔNG!', 'success');
                await esptoolTransport.disconnect();
            } catch (err) {
                logToTerminal(`❌ LỖI NẠP: ${err.message}`, 'error');
            }
        }

        async function eraseChipFlash() {
            if (!confirm('Xác nhận XÓA SẠCH bộ nhớ chip?')) return;
            if (isConnected) await disconnectPort();
            try {
                logToTerminal('⚠️ Đang XÓA SẠCH bộ nhớ chip...', 'error');
                const flashPort = await navigator.serial.requestPort();
                const esptoolTransport = new ESPOptions.Transport(flashPort);
                const esploader = new ESPOptions.ESPLoader({
                    transport: esptoolTransport,
                    baudrate: 115200,
                    terminal: { clean: () => {}, writeLine: (d) => logToTerminal(d, 'flash'), write: (d) => logToTerminal(d, 'flash') }
                });
                await esploader.main();
                await esploader.eraseFlash();
                logToTerminal('✅ ĐÃ XÓA SẠCH CHIP THÀNH CÔNG!', 'success');
                await esptoolTransport.disconnect();
            } catch(err) {
                logToTerminal(`❌ Lỗi xóa chip: ${err.message}`, 'error');
            }
        }

