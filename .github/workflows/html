        async function toggleConnect() {
            playBeep(700, 0.06);
            if (isConnected) await disconnectPort();
            else await connectPort();
        }

        async function connectPort() {
            try {
                const baud = parseInt(document.getElementById('terminalBaud').value);
                port = await navigator.serial.requestPort();
                await port.open({ baudRate: baud });
                isConnected = true;
                updateConnectionUI(true);
                logToTerminal(`✅ Đã mở cổng Serial thành công (${baud} Baud)!`, 'success');
                readSerialLoop();
            } catch (err) {
                logToTerminal(`❌ Lỗi kết nối Serial: ${err.message}`, 'error');
                updateConnectionUI(false);
            }
        }

        async function disconnectPort() {
            try {
                if (reader) { await reader.cancel(); reader = null; }
                if (writer) { writer.releaseLock(); writer = null; }
                if (port) { await port.close(); port = null; }
            } catch(e) {}
            isConnected = false;
            updateConnectionUI(false);
            logToTerminal('🔌 Đã ngắt kết nối cổng Serial.', 'info');
        }

        async function readSerialLoop() {
            const textDecoder = new TextDecoderStream();
            port.readable.pipeTo(textDecoder.writable);
            reader = textDecoder.readable.getReader();
            try {
                while (true) {
                    const { value, done } = await reader.read();
                    if (done) break;
                    if (value) logToTerminal(value, 'device');
                }
            } catch(e) {} finally { reader.releaseLock(); }
        }

        async function sendSerialData(data) {
            if (!port || !port.writable) return;
            const encoder = new TextEncoderStream();
            encoder.readable.pipeTo(port.writable);
            writer = encoder.writable.getWriter();
            try {
                await writer.write(data);
                logToTerminal(`➡️ [SEND]: ${data.trim()}`, 'sent');
            } catch(e) {} finally { writer.releaseLock(); }
        }

        function sendCustomSerial() {
            const input = document.getElementById('serialInput');
            if (input.value.trim()) {
                sendSerialData(input.value + '\n');
                input.value = '';
            }
        }

        function handleSerialKeyDown(e) {
